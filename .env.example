# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key. Public by design: anon has no table privileges.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Long random string used to hash IP addresses for rate limiting (min 16 chars).
# Generate with: openssl rand -base64 32
RATE_LIMIT_SALT=
# Public site URL, used in auth email links. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# Demo account (read-only). Server only.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
